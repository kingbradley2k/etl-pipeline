# PostgreSQL connection settings. Copy this file to .env and change values locally.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=weather_etl
POSTGRES_USER=weather_user
POSTGRES_PASSWORD=change_me

# Application settings
LOG_LEVEL=INFO
RAW_DATA_DIR=data/raw
SCHEDULE_MINUTES=60
TIMEZONE=Africa/Nairobi

# HTTP extraction behaviour
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF_SECONDS=1
